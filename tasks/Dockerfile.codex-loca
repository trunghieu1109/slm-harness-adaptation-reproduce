# syntax=docker/dockerfile:1.7

FROM python:3.14-slim

ARG USER_UID
ARG CODEX_VERSION=0.149.0

ENV HOME=/workspace \
    CODEX_HOME=/workspace/.codex \
    VIRTUAL_ENV=/workspace/.venv \
    PATH="/workspace/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/workspace \
    LOCA_BENCH_PATH=/loca-bench

WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gcc \
    g++ \
    git \
    jq \
    make \
    nodejs \
    npm \
    poppler-utils \
    python3-dev \
    ripgrep \
 && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.9.2 /uv /bin/uv
COPY LOCA-bench/mcp_convert /loca-bench/mcp_convert

RUN npm install --global "@openai/codex@${CODEX_VERSION}" \
 && npm cache clean --force \
 && useradd --create-home --home-dir /workspace --shell /bin/bash --uid "$USER_UID" appuser \
 && mkdir -p /workspace/.codex /workspace/project \
 && chown -R appuser:appuser /workspace

USER appuser

RUN uv venv /workspace/.venv \
 && uv pip install \
      "mcp>=1.9.0,<2" \
      /loca-bench/mcp_convert \
      "openpyxl>=3.1.5"

ENTRYPOINT ["sleep", "infinity"]
